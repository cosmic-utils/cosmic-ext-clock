# Software-rendered environment for Clock preview screenshots.
# Like Camera, fresh builds use Fedora's current packages; CI reuses the built
# image until the Containerfile changes or the image cache expires.
FROM registry.fedoraproject.org/fedora:44

RUN dnf install -y --setopt=install_weak_deps=False \
        rust cargo gcc gcc-c++ pkgconf-pkg-config git \
        wayland-devel libxkbcommon-devel dbus-devel \
        sway grim wtype jq dbus-daemon procps-ng \
        mesa-vulkan-drivers vulkan-loader mesa-libGL mesa-libEGL mesa-dri-drivers \
        cosmic-icon-theme adwaita-icon-theme hicolor-icon-theme open-sans-fonts \
        ImageMagick oxipng \
    && dnf clean all

# Seed the actual COSMIC light and dark defaults instead of libcosmic's fallback
# palette. Installing cosmic-settings would pull in the whole settings app.
# Follow Fedora's current theme package, as Camera does, rather than depending
# on a superseded version remaining available on the mirrors.
RUN dnf install -y --setopt=install_weak_deps=False 'dnf-command(download)' cpio \
    && dnf download --destdir /tmp/cosmic-theme cosmic-settings \
    && ( cd / && rpm2cpio /tmp/cosmic-theme/cosmic-settings-*.rpm \
           | cpio -idmv './usr/share/cosmic/com.system76.CosmicTheme.*' ) \
    && test -f /usr/share/cosmic/com.system76.CosmicTheme.Dark/v1/accent \
    && test -f /usr/share/cosmic/com.system76.CosmicTheme.Light/v1/accent \
    && rm -rf /tmp/cosmic-theme \
    && dnf clean all

RUN setcap -r /usr/bin/sway
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json \
    WGPU_BACKEND=vulkan \
    LIBGL_ALWAYS_SOFTWARE=1 \
    WLR_BACKENDS=headless \
    WLR_RENDERER=pixman \
    WLR_LIBINPUT_NO_DEVICES=1 \
    CARGO_TERM_COLOR=always \
    RUST_LOG=warn
WORKDIR /src
ENTRYPOINT ["/bin/bash"]
CMD ["-c", "preview/capture-previews.sh /tmp/shots && preview/sync-previews.sh /tmp/shots preview"]
